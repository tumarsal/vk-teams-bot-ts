{
  "name": "@tumarsal/vk-teams-bot-ts",
  "version": "1.0.0",
  "description": "TypeScript SDK для VK Teams / ICQ Bot API (порт bot-golang)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tumarsal/vkteams.git",
    "directory": "bot-ts"
  },
  "main": "./dist-cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run postbuild:rename",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "postbuild:rename": "node ./scripts/rename-cjs.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
